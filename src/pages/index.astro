---
import Layout from "../layouts/Layout.astro";
import { DockDemo } from "../components/magicui/dockDemo";
import HeroSection from "@/components/HeroSection.astro";
import Educacion from "@/components/Education.astro";
import Proyectos from "@/components/Proyects.astro";
import Habilidades from "@/components/Skills.astro";
import SobreMi from "@/components/AboutMe.astro";
---

<Layout title="Ivo Barinstein">
  <div class="relative flex min-h-dvh flex-col items-center">
    
    <!-- Construction Overlay
    <div class="absolute top-0 left-0 w-full h-full flex flex-col items-center justify-center gap-4">
      <p class="text-5xl font-bold text-white font-diagraphetc">Sitio en construcción</p>
      <img src="https://blob.gifcities.org/gifcities/3RCG747DO6MDJSNFODWGCK7YRNZPRCGZ.gif" alt="Construction GIF" class="w-150" />
    </div>
    -->

    <main class="w-full h-screen max-w-[1200px] px-12 max-sm:px-4">
      <section id="section-0" class="mb-20">
        <HeroSection />
      </section>
      <hr class="my-8 border-slate-600" />

      <section id="section-1">
        <SobreMi />
      </section>
      <hr class="my-8 border-slate-600" />

      <section id="section-2">
        <Educacion />
      </section>
      <hr class="my-8 border-slate-600" />

      <section id="section-3">
        <Habilidades />
      </section>

      <hr class="my-8 border-slate-600" />
      <section id="section-4">
        <Proyectos />
      </section>
    </main>
  </div>
  <div class="fixed bottom-10 left-0 right-0 z-50">
    <DockDemo client:load />
  </div>
</Layout>
