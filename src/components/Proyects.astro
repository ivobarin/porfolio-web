---
const PROJECTS = [
  {
    title: "Sala de Juegos",
    img: "img/SalaJuegos.jpg",
    description:
      "Proyecto para la materia de Programacion IV. Permite a los usuarios registrarse, iniciar sesión y acceder a 4 juegos clasicos. Además, los usuarios pueden hablar por un chat en tiempo real, y ver su historial de juegos y tabla de clasificación por juego.",
    preview: "https://ivo-barinstein-tp1-prog4-2026-c1.vercel.app/",
    stack: ['angular', 'supabase', 'typescript'],
  },
  {
    title: 'Ivo Barinstein Portfolio',
    img: 'img/placeholder.jpg',
    description: 'Este portafolio, desarrollado con Astro y Tailwind CSS. Presenta mis proyectos, habilidades y experiencia de manera atractiva y funcional.',
    stack: ['astro', 'tailwindCss', 'react', 'typescript' ]
  },
  {
    title: "Tienda Manch",
    img: "img/tienda-manch.jpg",
    description:
      "Proyecto final que simula una tienda e-commerce especializada en bebidas, con funcionalidades completas de navegación, autenticación y un panel de gestión de productos para los administradores.",
    preview: "https://ivobarin.github.io/tienda-manch/",
    repo: "https://github.com/ivobarin/tienda-manch",
    stack: ['react', 'reactRouter', 'javascript'],
  },
  {
    title: "Youtube Downloader",
    img: "https://raw.githubusercontent.com/ivobarin/Py-Youtube-Downloader/refs/heads/main/other/demostration.gif",
    description:
      "Programa de escritorio desarrollado con Python y Tkinter que permite a los usuarios descargar videos de YouTube en la mejor calidad posible. Interfaz sencilla donde se pueden pegar la URL del video, seleccionar el formato deseado (video o audio) antes de iniciar la descarga.",
    repo: "https://github.com/ivobarin/Py-Youtube-Downloader",
    stack: ['python','pypi'],
    preview: null
  }, 
  {
    title: 'Google Ta Te Ti',
    img: 'img/ta-te-ti.png',
    description: 'Clon del juego Ta Te Ti (Tic Tac Toe) de Google, desarrollado con HTML, CSS y JavaScript. Permite a dos jugadores competir en un tablero interactivo, con detección automática de victorias y empates.',
    preview: 'https://ivobarin.github.io/simple-tic-tac-toe/',
    repo: 'https://github.com/ivobarin/simple-tic-tac-toe',
    stack: ['html5', 'css', 'javascript'],
  }
];

import ProyectItem from "./ProyectItem.astro";
import { Briefcase } from "lucide-react";
import SectionTitle from "./ui/SectionTitle";
---

<section class="rounded-xl mx-4 mt-8">
  <div class="w-full mx-auto p-4">
    <div class="mb-4">
      <SectionTitle title="Proyectos" icon={Briefcase} />
    </div>
    <div class="mt-12">
      <ol class="grid grid-cols-1 gap-3 mt-6">
        {
          PROJECTS.map((project) => (
            <li>
              <ProyectItem
                title={project.title}
                preview={project.preview}
                repo={project.repo}
                description={project.description}
                stack={project.stack}
                img={project.img}
              />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
